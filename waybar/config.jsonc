{
    "position": "top",

    "modules-left": ["sway/workspaces", "hyprland/workspaces"],
    "modules-center": ["mpris"],
    "modules-right": ["tray", "clock"],

    "sway/workspaces": {
        "disable-scroll": true
    },

    // Replaces: status_command while date +'%-m-%-d %X'; do sleep 1; done
    "clock": {
        "interval": 1,
        "format": "{:%A, %d %B %Y %R}"
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "mpris": {
	"format": "{player_icon} {dynamic}",
	"format-paused": "{status_icon} <i>{dynamic}</i>",
	"player-icons": {
		"default": "▶",
		"mpv": "🎵"
	},
	"status-icons": {
		"paused": "⏸"
	}
	// "ignored-players": ["firefox"]
}
}
