{
    "position": "top",

    "modules-left": ["sway/workspaces"],
    "modules-center": [],
    "modules-right": ["clock", "tray"],

    "sway/workspaces": {
        "disable-scroll": true
    },

    // Replaces: status_command while date +'%-m-%-d %X'; do sleep 1; done
    "clock": {
        "interval": 1,
        "format": "{:%A, %d %B %Y %R)"
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    }
}